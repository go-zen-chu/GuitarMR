{
  "name": "@guitarmr/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "tky, the phone page as one HTML file: scan PDFs and photos into gts, read them with Claude, check, edit and play them",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:android": "node scripts/build.ts --android",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@guitarmr/extract": "workspace:*",
    "@guitarmr/gts": "workspace:*",
    "@guitarmr/layoutscan": "workspace:*",
    "@guitarmr/samples": "workspace:*",
    "@types/node": "26.6.2",
    "pdfjs-dist": "6.3.289",
    "typescript": "7.0.2"
  }
}
